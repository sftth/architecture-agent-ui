# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version

# Node
node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store

# Runtime data
backend/runs/*
!backend/runs/.gitkeep

# 계정(비밀번호 해시) / 로그인 세션 / 계정별 architecture-agent 경로 (서버 로컬 상태, 공유 X)
backend/data/*
!backend/data/.gitkeep

# Scouter webapp 배포본(20MB 바이너리) — 저장소에 넣지 않는다. README 의 APM 절대로 각자 놓는다.
# conf/scouter.conf 에는 Collector 비밀번호가 풀어 써지고, logs/ 는 로컬 로그다.
backend/vendor/

# Editor
.vscode/
.idea/

# 개인 로컬 설정 — 사람마다 다르고 공유할 값이 아니다(.local 이름이 그 뜻이다).
.claude/settings.local.json
